# ==============================================================================
# 1. Pulumi DIY State Backend (Dedicated jbrd-ops Supabase Project)
# ==============================================================================
PULUMI_STATE_PGHOST="aws-1-[REGION].pooler.supabase.com"
PULUMI_STATE_PGPORT="5432"
PULUMI_STATE_PGDATABASE="postgres"
PULUMI_STATE_PGUSER="postgres.[OPS_PROJECT_REF]"
PULUMI_STATE_PGPASSWORD="[OPS_PASSWORD]"
PULUMI_STATE_PGSSLMODE="require"

# Passphrase used by Pulumi to encrypt secrets in state
PULUMI_CONFIG_PASSPHRASE="choose-a-strong-passphrase"


# ==============================================================================
# 2. Target Application PostgreSQL (Application Supabase Project)
# ==============================================================================
# Connection details for the app DB where schemas & roles will actually be created
TARGET_PGHOST="aws-0-[REGION].pooler.supabase.com"
TARGET_PGPORT="5432"
TARGET_PGDATABASE="postgres"
TARGET_PGUSER="postgres.[APP_PROJECT_REF]"
TARGET_PGPASSWORD="[APP_DB_PASSWORD]"
TARGET_PGSSLMODE="require"


# ==============================================================================
# 3. Cloudflare Credentials (for Secrets Store)
# ==============================================================================
CLOUDFLARE_API_TOKEN="[CLOUDFLARE_API_TOKEN]"
CLOUDFLARE_ACCOUNT_ID="[CLOUDFLARE_ACCOUNT_ID]"
CLOUDFLARE_SECRETS_STORE_ID="[SECRETS_STORE_ID]"
